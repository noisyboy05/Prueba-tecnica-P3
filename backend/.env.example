NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://user:password@localhost:5432/saas_flow?schema=public"

# JWT
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=24h

# CORS — solo requerido en NODE_ENV=production
# En desarrollo se permite http://localhost:5173 automáticamente.
# Para producción: separar múltiples orígenes con coma.
ALLOWED_ORIGIN=https://tudominio.com

# Logging
LOG_LEVEL=info
